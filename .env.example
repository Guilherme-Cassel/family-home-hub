# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard > seu projeto > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Projetos novos chamam de "publishable key" (sb_publishable_...).
# Projetos antigos chamam de "anon key" (um JWT longo) — nesse caso use
# NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar desta linha. Qualquer uma das duas serve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# NUNCA prefixe com NEXT_PUBLIC_: esta chave só pode existir no servidor.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo usado nas duas rotas de IA.
#
# O padrao e o flash-lite por medicao, nao por chute: com 6 fotos de 1024x768
# ele respondeu em 5s contra 34s do gemini-3.5-flash (que chegou a 112s numa
# das chamadas). Para reconhecer embalagem de supermercado a qualidade empata,
# e a latencia decide se a funcao da Vercel termina a tempo.
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelos tentados em sequencia se o principal responder 503. O 503 do Gemini
# e falta de capacidade por modelo, do lado do Google, e atinge um tier
# enquanto os outros seguem normais - por isso trocar de modelo resolve o que
# nenhum retry no mesmo modelo resolveria.
GEMINI_MODEL_FALLBACK=gemini-3.6-flash,gemini-3.5-flash

# Quantas fotos vao em uma unica requisicao ao Gemini. Lotes maiores gastam
# menos requisicoes da cota diaria; lotes menores falham menos.
GEMINI_BATCH_SIZE=6

# ---------------------------------------------------------------------------
# Cron diario que impede o Supabase de pausar por inatividade.
# Gere um valor aleatorio qualquer. A Vercel envia esse valor no cabecalho
# Authorization ao disparar o cron; sem ele, o endpoint fica aberto.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
CRON_SECRET=
