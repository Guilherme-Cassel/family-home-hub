# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard > seu projeto > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Projetos novos chamam de "publishable key" (sb_publishable_...).
# Projetos antigos chamam de "anon key" (um JWT longo) — nesse caso use
# NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar desta linha. Qualquer uma das duas serve.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# NUNCA prefixe com NEXT_PUBLIC_: esta chave só pode existir no servidor.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo usado nas duas rotas de IA. Alternativas: gemini-3.5-flash-lite
# (mais econômico em cota) ou gemini-3.7-flash (mais recente).
GEMINI_MODEL=gemini-3.5-flash

# Quantas fotos vão em uma única requisição ao Gemini. Lotes maiores gastam
# menos requisições da cota diária; lotes menores falham menos.
GEMINI_BATCH_SIZE=6
